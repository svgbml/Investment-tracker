{
  "id": "./",
  "name": "Investeringstracker",
  "short_name": "Beleggen",
  "description": "Persoonlijke tracker voor je Trading 212-portefeuille",
  "lang": "nl",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#2B2F36",
  "theme_color": "#E8EDFA",
  "icons": [
    {
      "src": "icons/blauw-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/blauw-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/blauw-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-monochrome-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "monochrome"
    }
  ],
  "shortcuts": [
    {
      "name": "Vandaag",
      "short_name": "Vandaag",
      "description": "Waarde, resultaat van vandaag en wat eraan komt",
      "url": "./#vandaag",
      "icons": [
        {
          "src": "icons/blauw-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Order plaatsen",
      "short_name": "Order",
      "description": "Kies een aandeel en plaats een order (als kopen aanstaat)",
      "url": "./#order",
      "icons": [
        {
          "src": "icons/blauw-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Nieuws",
      "short_name": "Nieuws",
      "description": "Nieuws, analisten en insiders",
      "url": "./#nieuws",
      "icons": [
        {
          "src": "icons/blauw-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Risico",
      "short_name": "Risico",
      "description": "Risicoklasse, wat samen beweegt en wat het risico verlaagt",
      "url": "./#risico",
      "icons": [
        {
          "src": "icons/blauw-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Plannen",
      "short_name": "Plannen",
      "description": "Inleg-assistent, doelen en vooruitblik",
      "url": "./#plannen",
      "icons": [
        {
          "src": "icons/blauw-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Bedrijven en volglijst",
      "short_name": "Bedrijven",
      "description": "Je posities en je volglijst",
      "url": "./#bedrijven",
      "icons": [
        {
          "src": "icons/blauw-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Status",
      "short_name": "Status",
      "description": "Meet je tracker nog goed?",
      "url": "./#status",
      "icons": [
        {
          "src": "icons/blauw-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "widgets": [
    {
      "name": "Vandaag",
      "short_name": "Vandaag",
      "description": "Waarde van je beleggingen en het resultaat van vandaag",
      "tag": "vandaag",
      "template": "vandaag",
      "ms_ac_template": "widget-vandaag.json",
      "data": "widget-vandaag-data.json",
      "type": "application/json",
      "auth": false,
      "update": 900,
      "icons": [
        {
          "src": "icons/blauw-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  },
  "prefer_related_applications": false
}
