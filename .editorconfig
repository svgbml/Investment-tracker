# Opmaak van bestanden in deze map (werkt in vrijwel elke editor).
# Bestaande bestanden worden niet opnieuw opgemaakt; dit geldt voor wat je nieuw typt.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[docs/vendor/**]
insert_final_newline = false
trim_trailing_whitespace = false
