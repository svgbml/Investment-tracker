{
  "ci": {
    "collect": {
      "staticDistDir": "./docs",
      "url": [
        "http://localhost/index.html?demo"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.5,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.8
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 450000
          }
        ],
        "resource-summary:stylesheet:size": [
          "error",
          {
            "maxNumericValue": 40000
          }
        ],
        "resource-summary:total:size": [
          "error",
          {
            "maxNumericValue": 700000
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 3000
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 300
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "dom-size": [
          "warn",
          {
            "maxNumericValue": 6000
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci-report"
    }
  }
}
